# Copy to terraform.tfvars (never commit)

project_id   = "voxcrew-private"
region       = "europe-west1"
service_name = "voxcrew-signaling"
environment  = "dev"

# Comma-separated Firebase UIDs allowed to use signaling
allowed_firebase_uids = "uid-user-1,uid-user-2"

# Container image (set after first build/push)
# container_image = "europe-west1-docker.pkg.dev/voxcrew-private/voxcrew/voxcrew-signaling:latest"
