# Copy to a secure location (mode 600). Never commit the filled file.
#
# Linux example:  /etc/voxcrew/relay.env
# macOS example:  ~/Library/Application Support/voxcrew/relay.env

RELAY_SECRET=replace-with-openssl-rand-base64-32
RELAY_PORT=8443

# Absolute paths recommended for service managers:
# RELAY_CERT=/opt/voxcrew/relay/certs/cert.pem
# RELAY_KEY=/opt/voxcrew/relay/certs/key.pem

# Lab only — never set on an internet-facing host:
# RELAY_ALLOW_INSECURE=1
