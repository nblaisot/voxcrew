<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install:
    sed -e "s|REPLACE_HOME|$HOME|g" -e "s|REPLACE_NODE|$(command -v node)|g" \
      deploy/com.nblaisot.voxcrew.relay.plist \
      > ~/Library/LaunchAgents/com.nblaisot.voxcrew.relay.plist
    launchctl load ~/Library/LaunchAgents/com.nblaisot.voxcrew.relay.plist

  Requires relay checked out at REPLACE_HOME/Services/voxcrew-relay
  and env at REPLACE_HOME/Library/Application Support/voxcrew/relay.env
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nblaisot.voxcrew.relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/Library/Application Support/voxcrew/relay.env"; set +a; exec REPLACE_NODE src/server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_HOME/Services/voxcrew-relay</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>REPLACE_HOME/Library/Logs/voxcrew-relay.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/Library/Logs/voxcrew-relay.err.log</string>
</dict>
</plist>
