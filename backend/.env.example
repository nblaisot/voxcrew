# Backend environment (copy to .env — never commit)

NODE_ENV=development
PORT=8080
GCP_PROJECT_ID=voxcrew-private
ALLOWED_FIREBASE_UIDS=uid-user-1,uid-user-2
LOG_LEVEL=info

# Optional: path to Firebase service account JSON for local prod-like auth
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
